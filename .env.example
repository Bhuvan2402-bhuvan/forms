# ============================================================================
# FormCraft Studio - Self-Hosted Environment Configuration
# Copy this file to .env and configure for your deployment
# ============================================================================

# --- Application Domain & Origin ---
# Canonical Public URL used for shareable form links, redirects, and webhooks.
# Example for local development: http://localhost:3005
# Example for Cloudflare Tunnel / Production: https://forms.yourdomain.com
APP_URL=http://localhost:3005

# Internal application server port
PORT=3005
NODE_ENV=production

# Strict Database Mode: Enforces PostgreSQL as the authoritative store and disables silent local JSON fallback
REQUIRE_POSTGRES=true

# --- Self-Hosted PostgreSQL Configuration ---
# Used by docker-compose to configure and connect to PostgreSQL
POSTGRES_DB=formcraft_db
POSTGRES_USER=formcraft
POSTGRES_PASSWORD=replace_with_a_secure_database_password_here

# Persistent storage host paths (absolute path or relative to docker-compose.yml)
# Example Ubuntu absolute path: /var/lib/formcraft/postgres_data
APP_POSTGRES_DATA_PATH=./postgres_data

# Local application file storage host path
# Example Ubuntu absolute path: /var/lib/formcraft/data
APP_DATA_PATH=./data

# Direct connection string (Optional; computed automatically by docker-compose)
# DATABASE_URL=postgresql://formcraft:password@postgres:5432/formcraft_db

# --- Security & Administrator Access ---
# Initial password for Studio Creator & Admin dashboard
ADMIN_PASSWORD=admin123

# Secret key used for signing administrative HMAC authentication tokens
ADMIN_SECRET=replace_with_a_64_character_random_hex_string_here


